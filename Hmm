<script>
"use strict";

const questions = [
  {topic:"mechanics", q:"Kütləsi 2 kq olan cismə 10 N qüvvə təsir edir. Cismin təcili nə qədərdir?", a:["5 m/s²","20 m/s²","0,2 m/s²","12 m/s²"], c:0, explain:"Nyutonun ikinci qanunu: a = F / m = 10 / 2 = 5 m/s²."},
  {topic:"electricity", q:"Cərəyan şiddəti 2 A, müqavimət 5 Ω-dur. Gərginlik neçə voltdur?", a:["10 V","2,5 V","7 V","0,4 V"], c:0, explain:"Om qanununa görə U = IR = 2 × 5 = 10 V."},
  {topic:"mechanics", q:"Mexaniki işin SI sistemində vahidi hansıdır?", a:["Joul (J)","Vatt (W)","Volt (V)","Nyuton (N)"], c:0, explain:"İşin vahidi joul (J), gücün vahidi isə vattdır."},
  {topic:"thermal", q:"Cismin temperaturunu dəyişmək üçün verilən istilik miqdarı hansı düsturla hesablanır?", a:["Q = cmΔT","F = ma","U = IR","P = A/t"], c:0, explain:"Temperatur dəyişəndə Q = cmΔT düsturundan istifadə olunur."},
  {topic:"mechanics", q:"Kütləsi 3 kq olan cismin 2 m hündürlükdə potensial enerjisi nə qədərdir? g = 10 m/s²", a:["60 J","15 J","6 J","30 J"], c:0, explain:"Eₚ = mgh = 3 × 10 × 2 = 60 J."},
  {topic:"electricity", q:"Elektrik cərəyanının şiddəti hansı ifadə ilə tapılır?", a:["I = q/t","U = IR","A = Fs","ρ = m/V"], c:0, explain:"Cərəyan şiddəti vahid zamanda keçən yükdür: I = q/t."}
];

const topicNames = {all:"Qarışıq test", mechanics:"Mexanika", electricity:"Elektrodinamika", thermal:"Molekulyar fizika"};
let activeQuestions = [...questions];
let index = 0;
let score = 0;
let answered = false;

const questionEl = document.getElementById("test-title");
const optionsEl = document.getElementById("options");
const feedbackEl = document.getElementById("feedback");
const nextBtn = document.getElementById("next");
const counterEl = document.getElementById("counter");
const progressEl = document.getElementById("progress");
const progressWrap = document.getElementById("progress-wrap");
const topicLabel = document.getElementById("topic-label");
const resultEl = document.getElementById("result");

function renderQuestion() {
  const item = activeQuestions[index];
  answered = false;
  questionEl.textContent = item.q;
  optionsEl.replaceChildren();
  feedbackEl.textContent = "";
  feedbackEl.className = "feedback";
  nextBtn.disabled = true;
  nextBtn.textContent = index === activeQuestions.length - 1 ? "Nəticəni gör →" : "Növbəti sual →";
  counterEl.textContent = `Sual ${index + 1} / ${activeQuestions.length}`;
  const percent = (index / activeQuestions.length) * 100;
  progressEl.style.width = `${percent}%`;
  progressWrap.setAttribute("aria-valuenow", String(Math.round(percent)));
  item.a.forEach((answer, answerIndex) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "opt";
    button.textContent = `${String.fromCharCode(65 + answerIndex)}) ${answer}`;
    button.addEventListener("click", () => chooseAnswer(answerIndex, button));
    optionsEl.appendChild(button);
  });
}

function chooseAnswer(answerIndex, selectedButton) {
  if (answered) return;
  answered = true;
  const item = activeQuestions[index];
  const buttons = [...optionsEl.querySelectorAll(".opt")];
  buttons.forEach((button, i) => {
    button.disabled = true;
    if (i === item.c) button.classList.add("correct");
  });
  if (answerIndex === item.c) {
    score++;
    feedbackEl.textContent = `Düzgündür! ${item.explain}`;
    feedbackEl.classList.add("good");
  } else {
    selectedButton.classList.add("wrong");
    feedbackEl.textContent = `Bu cavab düzgün deyil. ${item.explain}`;
    feedbackEl.classList.add("bad");
  }
  nextBtn.disabled = false;
  const percent = ((index + 1) / activeQuestions.length) * 100;
  progressEl.style.width = `${percent}%`;
  progressWrap.setAttribute("aria-valuenow", String(Math.round(percent)));
}

function showResult() {
  questionEl.hidden = true;
  optionsEl.hidden = true;
  feedbackEl.hidden = true;
  nextBtn.hidden = true;
  document.getElementById("restart").hidden = true;
  resultEl.style.display = "block";
  counterEl.textContent = "Test bitdi";
  progressEl.style.width = "100%";
  progressWrap.setAttribute("aria-valuenow", "100");
  document.getElementById("score").textContent = `${score} / ${activeQuestions.length}`;
  const ratio = score / activeQuestions.length;
  document.getElementById("result-message").textContent =
    ratio === 1 ? "Əla! Bütün suallara düzgün cavab verdin." :
    ratio >= 0.7 ? "Yaxşı nəticədir. Səhv etdiyin mövzuları bir də təkrarla." :
    "Düsturları təkrarla və yenidən sına. Məşq etdikcə nəticən yaxşılaşacaq.";
}

function resetTest(topic = "all") {
  activeQuestions = topic === "all" ? [...questions] : questions.filter(item => item.topic === topic);
  if (!activeQuestions.length) activeQuestions = [...questions];
  index = 0;
  score = 0;
  questionEl.hidden = false;
  optionsEl.hidden = false;
  feedbackEl.hidden = false;
  nextBtn.hidden = false;
  document.getElementById("restart").hidden = false;
  resultEl.style.display = "none";
  topicLabel.textContent = topicNames[topic] || topicNames.all;
  renderQuestion();
}

nextBtn.addEventListener("click", () => {
  if (!answered) return;
  if (index < activeQuestions.length - 1) {
    index++;
    renderQuestion();
  } else {
    showResult();
  }
});
document.getElementById("restart").addEventListener("click", () => resetTest(currentTopic));
document.getElementById("again").addEventListener("click", () => resetTest(currentTopic));

let currentTopic = "all";
document.querySelectorAll("[data-topic]").forEach(link => {
  link.addEventListener("click", () => {
    currentTopic = link.dataset.topic;
    resetTest(currentTopic);
  });
});
resetTest();
</script>
</body>
</html>
'''

path = Path("/mnt/data/1-ci_qrup_fizika_pro.html")
